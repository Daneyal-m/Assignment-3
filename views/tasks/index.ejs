<%- include('../partials/header', { title: 'All items' }) %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h2 mb-0">All items</h1>
  <a href="/tasks/new" class="btn btn-primary">Add item</a>
</div>

<% if (tasks.length === 0) { %>
  
  <div class="alert alert-info">Nothing here yet. Add your first item.</div>
<% } else { %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Title</th>
        <th>Course</th>
        <th>Type</th>
        <th>Due</th>
        <th>Priority</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      
      <% tasks.forEach(t => { %>
        <tr>
          <td><%= t.title %></td>
          <td><%= t.course %></td>
          <td><%= t.type %></td>
          <td><%= new Date(t.dueDate).toLocaleDateString('en-CA', { timeZone: 'UTC' }) %></td>
          <td><%= t.priority %></td>
          <td><%= t.status %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>